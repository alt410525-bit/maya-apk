      "description": "Material3 defaults to Roboto; no custom font configured in project"
    },
    "scale": {
      "display-large": { "size": 57, "lineHeight": 64, "weight": 400, "letterSpacing": -0.25, "description": "Material3 displayLarge" },
      "display-medium": { "size": 45, "lineHeight": 52, "weight": 400, "description": "Material3 displayMedium" },
      "display-small": { "size": 36, "lineHeight": 44, "weight": 400, "description": "Material3 displaySmall" },
      "headline-large": { "size": 32, "lineHeight": 40, "weight": 400, "description": "Material3 headlineLarge" },
      "headline-medium": { "size": 28, "lineHeight": 36, "weight": 400, "description": "Material3 headlineMedium" },
      "headline-small": { "size": 24, "lineHeight": 32, "weight": 400, "description": "Material3 headlineSmall" },
      "title-large": { "size": 22, "lineHeight": 28, "weight": 500, "description": "Material3 titleLarge" },
      "title-medium": { "size": 16, "lineHeight": 24, "weight": 500, "description": "Material3 titleMedium" },
      "title-small": { "size": 14, "lineHeight": 20, "weight": 500, "description": "Material3 titleSmall" },
      "label-large": { "size": 14, "lineHeight": 20, "weight": 500, "description": "Material3 labelLarge" },
      "label-medium": { "size": 12, "lineHeight": 16, "weight": 500, "description": "Material3 labelMedium" },
      "label-small": { "size": 11, "lineHeight": 16, "weight": 500, "description": "Material3 labelSmall" },
      "body-large": { "size": 16, "lineHeight": 24, "weight": 400, "description": "Material3 bodyLarge" },
      "body-medium": { "size": 14, "lineHeight": 20, "weight": 400, "description": "Material3 bodyMedium" },
      "body-small": { "size": 12, "lineHeight": 16, "weight": 400, "description": "Material3 bodySmall" },

      "settings-label": { "size": 16, "lineHeight": 24, "weight": 500, "description": "SettingsRow label (CommonComponents.kt line 62)" },
      "settings-subtitle": { "size": 13, "lineHeight": 20, "weight": 400, "description": "SettingsRow subtitle (line 69)" },
      "section-header": { "size": 14, "lineHeight": 20, "weight": 700, "description": "SectionHeader title (line 219)" },
      "slider-label": { "size": 14, "lineHeight": 20, "weight": 400, "description": "SettingsSlider label (line 183)" },
      "slider-value": { "size": 14, "lineHeight": 20, "weight": 500, "description": "SettingsSlider value (line 190)" },
      "top-app-bar-title": { "size": 16, "lineHeight": 24, "weight": 600, "description": "BackTopAppBar title (line 230)" }
    }
  },

  "spacing": {
    "base": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 48, 56, 64, 72, 80, 96, 128],
    "named": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48,
      "3xl": 64,
      "4xl": 96,
      "component-padding-vertical": 8,
      "component-padding-horizontal": 16,
      "icon-size-sm": 20,
      "icon-size-md": 24,
      "icon-size-lg": 32,
      "toggle-width": 36,
      "toggle-height": 36,
      "top-app-bar-height": 64
    },
    "usage": {
      "settings-row-vertical": "8dp (line 41)",
      "leading-icon-size": "24dp (line 46)",
      "leading-icon-gap": "12dp (line 51)",
      "trailing-gap": "8dp (line 74)",
      "section-header-gap": "implicit via Column"
    }
  },

  "radius": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999,
    "named": {
      "card": 16,
      "button": 12,
      "toggle-track": 18,
      "chip": 9999,
      "bottom-sheet": 24,
      "dialog": 28
    }
  },

  "shadow": {
    "levels": {
      "none": "none",
      "xs": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "sm": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
      "2xl": "0 25px 50px -12px rgb(0 0 0 / 0.25)"
    },
    "compose": {
      "elevation-0": "0dp",
      "elevation-1": "1dp",
      "elevation-2": "3dp",
      "elevation-3": "6dp",
      "elevation-4": "8dp",
      "elevation-5": "12dp"
    },
    "note": "Material3 uses elevation tokens; exact shadows rendered by platform. CardDark surfaces use elevation 1-3 typically."
  },

  "motion": {
    "easing": {
      "standard": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0.0, 1, 1)",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "emphasized": "cubic-bezier(0.4, 0.0, 0.2, 1)"
    },
    "duration": {
      "instant": 0,
      "fast": 100,
      "normal": 200,
      "slow": 300,
      "slower": 500
    },
    "named": {
      "ripple": "100ms standard",
      "fade": "150ms decelerate",
      "slide": "200ms standard",
      "expand": "250ms emphasized",
      "bottom-sheet": "300ms standard",
      "dialog": "200ms standard"
    }
  },

  "layout": {
    "maxContentWidth": 480,
    "breakpoints": {
      "mobile": 0,
      "tablet": 600,
      "desktop": 840
    },
    "headerHeight": 64,
    "navigationRailWidth": 72,
    "sidebarWidth": 280,
    "bottomNavHeight": 80,
    "insetTop": "system",
    "insetBottom": "system"
  },

  "breakpoints": {
    "mobile": 0,
    "tablet": 600,
    "desktop": 840
  },

  "zIndex": {
    "base": 0,
    "dropdown": 100,
    "sticky": 200,
    "modal-backdrop": 1000,
    "modal": 1010,
    "toast": 2000,
    "tooltip": 2100
