{
  "version": "1.0",
  "name": "Maya Clone Design Tokens",
  "description": "Extracted from existing Compose theme (Color.kt, Theme.kt, CommonComponents.kt)",
  "source": "com.maya.clone.ui.theme + com.maya.clone.ui.components",

  "color": {
    "roles": {
      "bg": { "value": "#070710", "description": "DarkBackground - app background" },
      "surface": { "value": "#0F0F1A", "description": "DarkSurface - elevated surfaces" },
      "surface-elevated": { "value": "#16162A", "description": "CardElevated - higher elevation cards" },
      "surface-card": { "value": "#1A1A2E", "description": "CardDark - standard cards" },
      "border": { "value": "#6A6A9A", "description": "Divider - borders, dividers (lightened for contrast)" },
      "border-input": { "value": "#7A7AAA", "description": "Input borders (lightened for contrast)" },

      "text": { "value": "#F8FAFC", "description": "TextPrimary - primary text" },
      "text-muted": { "value": "#94A3B8", "description": "TextSecondary - secondary text" },
      "text-dim": { "value": "#64748B", "description": "TextTertiary - disabled/placeholder" },
      "text-on-accent": { "value": "#070710", "description": "Text on accent (DarkBackground)" },

      "accent": { "value": "#7C4DFF", "description": "NeonPurple - primary brand (darkened for contrast)" },
      "accent-on": { "value": "#F8FAFC", "description": "onPrimary - TextPrimary" },
      "accent-secondary": { "value": "#22D3EE", "description": "NeonCyan - secondary brand" },
      "accent-secondary-on": { "value": "#070710", "description": "onSecondary - DarkBackground" },
      "accent-tertiary": { "value": "#D81B60", "description": "NeonPink - tertiary brand (darkened for contrast)" },
      "accent-tertiary-on": { "value": "#F8FAFC", "description": "onTertiary - TextPrimary" },

      "success": { "value": "#10B981", "description": "Success - positive states" },
      "success-on": { "value": "#070710", "description": "On success" },
      "warning": { "value": "#F59E0B", "description": "Warning - caution states" },
      "warning-on": { "value": "#070710", "description": "On warning" },
      "danger": { "value": "#DC2626", "description": "Error - destructive actions (darkened for contrast)" },
      "danger-on": { "value": "#F8FAFC", "description": "On danger" },

      "focus-ring": { "value": "#8B5CF6", "description": "Focus indicator (NeonPurple)" },
      "overlay-scrim": { "value": "#000000CC", "description": "Modal backdrop (80% black)" },
      "disabled-bg": { "value": "#1A1A2E80", "description": "CardDark at 50% alpha" },
      "disabled-text": { "value": "#64748B", "description": "TextTertiary" }
    },

    "category": {
      "chat": { "value": "#22D3EE", "description": "ChatColor - NeonCyan" },
      "settings": { "value": "#8B5CF6", "description": "SettingsColor - NeonPurple" },
      "files": { "value": "#10B981", "description": "FilesColor - Success" },
      "voice": { "value": "#EC4899", "description": "VoiceColor - NeonPink" },
      "awareness": { "value": "#F59E0B", "description": "AwarenessColor - Warning" }
    },

    "pairs": [
      { "fg": "text", "bg": "bg", "min": 4.5, "context": "Body text on app background" },
      { "fg": "text-muted", "bg": "bg", "min": 3.0, "context": "Secondary text on app background" },
      { "fg": "text", "bg": "surface", "min": 4.5, "context": "Primary text on surface" },
      { "fg": "text-muted", "bg": "surface", "min": 3.0, "context": "Secondary text on surface" },
      { "fg": "text", "bg": "surface-card", "min": 4.5, "context": "Primary text on card" },
      { "fg": "text-muted", "bg": "surface-card", "min": 3.0, "context": "Secondary text on card" },
      { "fg": "text-dim", "bg": "surface-card", "min": 3.0, "context": "Placeholder text on card" },
      { "fg": "accent-on", "bg": "accent", "min": 4.5, "context": "Text on primary button" },
      { "fg": "accent-secondary-on", "bg": "accent-secondary", "min": 4.5, "context": "Text on secondary button" },
      { "fg": "accent-tertiary-on", "bg": "accent-tertiary", "min": 4.5, "context": "Text on tertiary button" },
      { "fg": "danger-on", "bg": "danger", "min": 4.5, "context": "Text on danger button" },
      { "fg": "success-on", "bg": "success", "min": 4.5, "context": "Text on success button" },
      { "fg": "warning-on", "bg": "warning", "min": 3.0, "context": "Text on warning button (large)" },
      { "fg": "text", "bg": "surface-elevated", "min": 4.5, "context": "Text on elevated surface" },
      { "fg": "border", "bg": "surface-card", "min": 3.0, "context": "Input border on card (AA large)" }
    ]
  },

